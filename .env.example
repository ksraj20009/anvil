# ANVIL — optional server-side keys for the hosted proxy (/api/chat).
# Set these in Vercel → Project → Settings → Environment Variables.
# They are ONLY used by the serverless proxy, never shipped to the browser.
# Users who bring their own key (BYOK) in the UI do not need these.
#
# Tip: set SARVAM_API_KEY and switch the app to "Use hosted proxy" to give every
# visitor free, key-less access on ANVIL's default provider.

SARVAM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
